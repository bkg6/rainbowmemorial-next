# Every env var the app reads at runtime. Diff this against your hosting
# provider's env to spot missing config. Build-time migrations require
# DATABASE_URL on production deploys (see netlify.toml).

# === Database ===
DATABASE_URL=

# === Cloudflare R2 (image storage) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rainbowmemorial

# === Razorpay (payments — active) ===
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_CURRENCY=USD
RAZORPAY_AMOUNT=2499

# === Resend (transactional email) ===
RESEND_API_KEY=

# === Anniversary cron auth ===
CRON_SECRET=

# === App ===
NEXT_PUBLIC_APP_URL=https://rainbow.memorial

# === Optional: deploy provenance (auto-set by Netlify/Vercel) ===
# COMMIT_REF=             # Netlify
# NETLIFY_COMMIT_REF=     # Netlify (alternate name in some contexts)
# VERCEL_GIT_COMMIT_SHA=  # Vercel
# CONTEXT=                # Netlify build context: "production" / "deploy-preview" / "branch-deploy"

# === Stripe (parked — not used at runtime, kept for future swap-back) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
